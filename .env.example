# ================================================================
# BirdSound Docker Environment Configuration
# ================================================================
# Copy to .env and adjust values
# Usage: docker-compose --env-file .env up -d
# ================================================================

# ----------------------
# PostgreSQL Database
# ----------------------
POSTGRES_USER=birdsound
POSTGRES_PASSWORD=birdsound_secret_change_me
POSTGRES_DB=birdsound
DB_PORT=5433

# ----------------------
# Redis Cache
# ----------------------
REDIS_PORT=6379

# ----------------------
# API Server
# ----------------------
API_PORT=8003
DEBUG=false

# ----------------------
# Models
# ----------------------
# BirdNET will download models automatically
USE_MODEL_STUBS=false

# ----------------------
# API Security (REQUIRED)
# ----------------------
# JSON list of valid API keys (generate with: openssl rand -hex 32)
# Clients must send the key in the X-API-Key header.
API_KEYS=["change_this_to_a_random_secret_key"]

# Allowed CORS origins as JSON list, e.g. ["https://myapp.example.com"]
CORS_ORIGINS=[]
